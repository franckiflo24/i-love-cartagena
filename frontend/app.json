{
  "expo": {
    "name": "Amo Cartagena",
    "slug": "amo-cartagena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amocartagena",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "pt": "./locales/pt.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amocartagena.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show you events and partners near you.",
        "NSPhotoLibraryUsageDescription": "Allow access to your photos to attach images to your events.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "instagram",
          "tel",
          "mailto"
        ]
      }
    },
    "android": {
      "package": "com.amocartagena.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ]
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#D97706",
      "androidMode": "default",
      "androidCollapsedTitle": "Amo Cartagena",
      "iosDisplayInForeground": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-amo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#020408"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to attach images to your events.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D97706",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "privacyPolicyUrl": "https://amocartagena.co/privacidad",
      "supportUrl": "https://amocartagena.co/ayuda",
      "router": {},
      "eas": {
        "projectId": "8c0b790c-2d94-44f2-9ec6-d50d0c9ed8ad"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "machinemind"
  }
}
