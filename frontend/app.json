{
  "expo": {
    "name": "AMO Life",
    "slug": "amo-cartagena",
    "version": "1.1.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amocartagena",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8c0b790c-2d94-44f2-9ec6-d50d0c9ed8ad"
    },
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "pt": "./locales/pt.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amocartagena.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:www.amocartagena.co",
        "applinks:amocartagena.co",
        "webcredentials:www.amocartagena.co",
        "webcredentials:amocartagena.co"
      ],
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show you events and partners near you.",
        "NSPhotoLibraryUsageDescription": "Allow access to your photos to attach images to your events.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "instagram",
          "tel",
          "mailto",
          "comgooglemaps",
          "uber"
        ],
        "NSCameraUsageDescription": "AMO uses the camera to scan ticket QR codes at the door."
      }
    },
    "android": {
      "package": "com.amocartagena.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ]
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#D97706",
      "androidMode": "default",
      "androidCollapsedTitle": "AMO Life",
      "iosDisplayInForeground": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/amo-life-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/images/splash-amo-life.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to attach images to your events.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D97706",
          "sounds": []
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to show you events and partners near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AMO usa la cámara para escanear los códigos QR de las entradas en la puerta."
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://amocartagena.co/privacidad",
      "supportUrl": "https://amocartagena.co/ayuda",
      "router": {},
      "eas": {
        "projectId": "8c0b790c-2d94-44f2-9ec6-d50d0c9ed8ad"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "machinemind"
  }
}
